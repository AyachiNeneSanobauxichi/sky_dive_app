{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(flutter pub get)",
      "Bash(flutter pub outdated)",
      "Bash(flutter pub add:*)",
      "Bash(flutter analyze)",
      "Bash(flutter analyze:*)",
      "Bash(flutter test)",
      "Bash(flutter test:*)",
      "Bash(flutter doctor)",
      "Bash(flutter devices)",
      "Bash(flutter --version)",
      "Bash(dart --version)",
      "Bash(dart format .)",
      "Bash(dart format:*)",
      "Bash(dart fix:*)",
      "Bash(dart analyze:*)",
      "Bash(dart run build_runner build:*)",
      "Bash(dart run build_runner watch:*)",
      "Bash(dart run build_runner clean)"
    ],
    "ask": [
      "Bash(flutter run:*)",
      "Bash(flutter build:*)",
      "Bash(git push:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)"
    ]
  }
}
